{
  "name": "reflexa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run dev:root",
    "dev:root": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "pnpm --filter reflexa-backend run dev",
    "dev:frontend": "pnpm --filter reflexa-frontend run dev",
    "build": "pnpm run -r build",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node e2e.mjs",
    "test:smoke": "node smoke-test.mjs",
    "check:all": "pnpm run typecheck && pnpm -w -r run test --run && pnpm -w -r run lint && node scripts/security-check.js && echo 'ALL CHECKS PASSED'",
    "check:types": "pnpm run typecheck",
    "check:tests": "pnpm -w -r run test --run",
    "check:security": "node scripts/security-check.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.27.5",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^2.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "prepare": "husky install"
}
