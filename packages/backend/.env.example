# ============================================================
# Reflexa Backend — Environment Variables
# Copy to packages/backend/.env and fill in values.
# CRITICAL variables are required at startup (server exits without them).
# ============================================================

# CRITICAL — Google Gemini API key
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# CRITICAL — Arize Phoenix Cloud
# Get from: https://app.phoenix.arize.com → Settings → API Keys
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces
PHOENIX_API_KEY=

# CRITICAL — Supabase
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# RECOMMENDED — CORS origin (defaults to http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# OPTIONAL
PORT=8000
LOG_LEVEL=info
# Set to 'false' to disable Phoenix MCP introspection (evaluation will use fallback)
PHOENIX_MCP_ENABLED=true
