# .env.example (place at repo root, committed to git)
# Copy to .env and fill in your values before running the backend.
# Never commit .env to version control.

# ── Required: Google AI ────────────────────────────────────────────────────
# Your Google Gemini API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ── Required: Arize Phoenix observability ──────────────────────────────────
# Get from https://app.phoenix.arize.com → Settings → API Keys
PHOENIX_API_KEY=your-phoenix-api-key-here

# OTLP ingest endpoint — find in Phoenix Cloud under Settings → Data Ingestion
# Format: https://app.phoenix.arize.com/s/{your-space}/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space/v1/traces

# Phoenix project name — appears in /projects/{name}/traces in the Phoenix UI
# Use 'default' if you haven't created a named project
PHOENIX_PROJECT_NAME=reflexa

# ── Required: Supabase database ────────────────────────────────────────────
# Your Supabase project URL from Project Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service role key (NOT the anon key) — from Project Settings → API → service_role
# Warning: never expose this in the frontend or client-side code
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Optional: Server configuration ────────────────────────────────────────
# Allowed CORS origin for the frontend. Required in production.
# In development, defaults to http://localhost:5173
FRONTEND_ORIGIN=https://your-frontend-domain.vercel.app

# Set to 'false' to disable Phoenix MCP server integration (for debugging only)
PHOENIX_MCP_ENABLED=true

# Server port (default: 8000)
PORT=8000
