# ============================================================
# Reflexa Backend — Environment Variables
# Copy this file to .env and fill in all required values.
# cp packages/backend/.env.example packages/backend/.env
# ============================================================

# --- Required ---

# Google Gemini API key
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Arize Phoenix Cloud — traces endpoint
# Use exactly this URL for Phoenix Cloud (do not change):
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces

# Arize Phoenix Cloud — API key
# Get from: https://app.phoenix.arize.com → Settings → API Keys
PHOENIX_API_KEY=

# Supabase — project URL and service role key
# Get from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend origin (used for CORS — must match your frontend URL exactly)
FRONTEND_ORIGIN=http://localhost:5173

# --- Optional ---

# Backend port (default: 8000)
PORT=8000

# Pino log level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info
