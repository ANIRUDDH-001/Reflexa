# .env.example (place at repo root, committed to git)
# Copy to .env and fill in your values.
# Never commit .env to version control.

# ── Cloud Run Deployment (Backend) ──────────────────────────────────────────────────
# When deploying to Google Cloud Run, separate your variables into:
# 1. Environment Variables (set directly on the service)
# 2. Secrets (stored in Google Secret Manager and mounted as environment variables)

# ── 1. Regular Environment Variables (Cloud Run Env Vars) ──────────────────

# Allowed CORS origin for the frontend. Required in production.
# In development, defaults to http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173,https://reflexa-498615.web.app,https://reflexa-498615.firebaseapp.com

# Arize project name — appears in the Arize AX UI
# Use 'reflexa' or any distinct name for this service
ARIZE_PROJECT_NAME=reflexa

# Set to 'false' to disable Arize MCP server integration (for debugging only)
ARIZE_MCP_ENABLED=true

# Server port (default: 8000). Cloud Run provides this automatically.
PORT=8000

# ── 2. Secrets (Store in Google Secret Manager) ────────────────────────────

# Your Google Gemini API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Get from https://app.arize.com/ -> Space Settings -> API Keys
ARIZE_API_KEY=your-arize-api-key-here

# Arize Space ID — find in Arize AX under Space Settings
ARIZE_SPACE_ID=your-arize-space-id-here

# Your Supabase project URL from Project Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service role key (NOT the anon key) — from Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── 3. Frontend Variables (Vite) ───────────────────────────────────────────
# These variables must start with VITE_ to be exposed to the browser.
# In production, VITE_API_URL should be your Cloud Run URL: https://reflexa-775591955827.asia-south2.run.app

VITE_API_URL=http://localhost:8000
VITE_APP_ENV=development

# Your Supabase project URL from Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon key (public) — from Project Settings → API → anon/public
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
