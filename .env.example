# Google Gemini API Key for the main AI models (Required)
GOOGLE_API_KEY=

# Phoenix API Key for trace ingestion (Required)
PHOENIX_API_KEY=

# Phoenix Collector Endpoint (Required)
# E.g. https://app.phoenix.arize.com/v1/traces or https://app.phoenix.arize.com/s/my-org/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=

# Phoenix Cloud project name — the project within your Phoenix space.
# Find it in your Phoenix Cloud URL: /s/{space}/projects/{THIS_VALUE}/traces
# Defaults to "default" if not set.
PHOENIX_PROJECT_NAME=reflexa-prod

# Supabase database configuration (Required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Frontend Origin for CORS configuration
FRONTEND_ORIGIN=http://localhost:5173
